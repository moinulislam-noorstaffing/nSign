# ── ports ───────────────────────────────────────────────────────────────────
STUDIO_PORT=8900
ONLYOFFICE_PORT=8090

# ── database ────────────────────────────────────────────────────────────────
POSTGRES_USER=studio
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=studio

# ── ONLYOFFICE ──────────────────────────────────────────────────────────────
# Signs BOTH directions: the editor config the browser receives, and the
# callback Document Server posts back. Verifying only one half leaves an
# unauthenticated file-write into the document store.
ONLYOFFICE_JWT_SECRET=CHANGE_ME
# Where the BROWSER reaches the editor — must resolve from your machine.
ONLYOFFICE_PUBLIC_URL=http://localhost:8090

# ── web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=

# ── PandaDoc (signature only — it cannot merge; it detects zero fields) ─────
PANDADOC_API_KEY=
PANDADOC_BASE_URL=https://api.pandadoc.com/public/v1

# ── OpenAI (authoring assistance only, never on the render path) ───────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── object storage (MinIO) ──────────────────────────────────────────────────
S3_ACCESS_KEY=studio
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=studio-documents
MINIO_CONSOLE_PORT=9101
